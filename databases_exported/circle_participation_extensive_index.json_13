ames": ["桜井電設工業所", "石川海砂"], "misc": ["Genre: 評論・情報\nName (kana): サクライデンセツコウギョ\nProduct: さおりちゃん新聞 第3号"]}, {"names": ["道の曲がりか堂"], "misc": ["Genre: 評論・情報\nName (kana): ミチノマガリカドウ\nProduct: ピヨピヨスポーツ"]}, {"names": ["神聖大ちゃん帝国", "ていとく"], "misc": ["Genre: 評論・情報\nName (kana): シンセイダイチャンテイコク\nProduct: 佐藤大輔作品リスト\nemail: teitoku37@mail.goo.ne.jp\n架空戦記作家、佐藤大輔のFC。主として作品リストなどを作成。架空戦記・秋山瑞人関係の同人誌もあり。", "http://www.ipc-tokai.or.jp/~tei-musyu/"]}, {"names": ["金田一耕助 FC", "みかん畑"], "misc": ["Genre: 評論・情報\nName (kana): キンダイチコウスケエフシー\nProduct: めいろそうのさんげき"]}, {"names": ["トレット症候群", "ニッシー"], "misc": ["Genre: 評論・情報\nName (kana): トレットショウコウグン"]}, {"names": ["PavT", "snaf"], "misc": ["Genre: 評論・情報\nName (kana): ピーエーヴィティー\nProduct: Perfect audio visual Theater COLLECTION･Ⅰ"]}, {"names": ["Virtual LaBoratory", "Satsuki"], "misc": ["Genre: 評論・情報\nName (kana): ヴァーチャルラボラトリー\nProduct: Yahoo! Auctions NOW\nemail: virtualabo@dokudenpa.org\n今回は、ネットオークションの経済メカニズムと転売行為について考えていきたいと思います。"]}, {"names": ["鳥頭雷撃文庫", "せれんでぃぴてぃ"], "misc": ["Genre: 評論・情報\nName (kana): トリアタマライゲキブンコ\nProduct: 大阪サウナ「屋」ガイド」"]}, {"names": ["MOUNTAIN魂", "極頂"], "misc": ["Genre: 評論・情報\nName (kana): マウンテンスピリット\nProduct: マウンテン魂流登山の仕方\nemail: kyokuchou3@excite.co.jp\n我々マウンテン魂は名古屋の名所『喫茶マウンテン』の紹介をしています。マウンテンに行った事のない人にはマウンテンのすごさを！！マウンテン行った事のある人にはマウンテンの奥深さを感じ取ってもらえたら幸いと思い活動しています。今回は【マウンテン魂流登山の仕方】というものを出そうと思います。内容は来てのお楽しみ当日皆さんと会えるのを楽しみにしています。マウンテン魂 極頂でした", "http://www.hm5.aitai.ne.jp/~kyoku-ss/"]}, {"names": ["Edelweiss", "下総房州"], "misc": ["Genre: 評論・情報\nName (kana): エーデルワイス\nProduct: 「おたく」とは何か？"]}, {"names": ["真城の城", "真城悠"], "misc": ["Genre: 評論・情報\nName (kana): マシロノシロ\nProduct: 「十九年目の孤独」"]}, {"names": ["ドリフト道場", "鶴岡法斎"], "misc": ["Genre: 評論・情報\nName (kana): ドリフトドウジョウ\nProduct: 8年の科学"]}, {"names": ["赤いうたごえ", "奥平広康"], "misc": ["Genre: 評論・情報\nName (kana): アカイウタゴエ\nProduct: 日本語で歌おう チョソンの歌"]}, {"names": ["富士ん口論社", "中年"], "misc": ["Genre: 評論・情報\nName (kana): フジンコウロンシャ\nProduct: 富士ん口論其ノ弐拾弐"]}, {"names": ["スコブル", "黒田外骨"], "misc": ["Genre: 評論・情報\nName (kana): スコブル\nProduct: 滑稽新聞"]}, {"names": ["はいさいど", "山口和伸"], "misc": ["Genre: 評論・情報\nName (kana): ハイサイド\nProduct: 同人誌取扱店ガイドブック"]}, {"names": ["ねるこみ実行委員会", "Tanaka"], "misc": ["Genre: 評論・情報\nName (kana): ネルコミジッコウイインカイ\nProduct: ねるこみのいろは"]}, {"names": ["迦陵頻伽", "八槌せいる"], "misc": ["Genre: 評論・情報\nName (kana): カラヴィンカ\nProduct: CANTARIDEATH vol.8\nemail: seiru@mac.email.ne.jp\n洋楽メタル中心に、読み物やライヴ感想等書いてます。評論に引っ越しての第1弾「CANTARIDEATH vol.8」は、自分が所持しているトリビュートアルバムの紹介などをやる予定。ライヴ感想はCARNAL FORGE in 福岡、THE HAUNTED in 大阪。DOJOでNAGLFARを見るかどうかは新刊のみぞ知る。", "http://www.ne.jp/asahi/myo-on/kalavinka/"]}, {"names": ["MISSION", "水岐京"], "misc": ["Genre: 評論・情報\nName (kana): ミッション\nProduct: いろものジュエリーBOOK．"]}, {"names": ["宝石道楽", "メリー"], "misc": ["Genre: 評論・情報\nName (kana): イシドウラク\nProduct: 宝石道楽のマナー"]}, {"names": ["すばる屋", "みすまる"], "misc": ["Genre: 評論・情報\nName (kana): スバルヤ\nProduct: 僕の標本箱4"]}, {"names": ["双晶宮", "五十嵐智子"], "misc": ["Genre: 評論・情報\nName (kana): ソウショウキュウ\nProduct: 水晶の本"]}, {"names": ["三日月塔", "三日月鳥"], "misc": ["Genre: 評論・情報\nName (kana): ミカヅキトウ\nProduct: 鉱石標本箱"]}, {"names": ["ガタケット事務局"], "misc": ["Genre: 評論・情報\nName (kana): ガタケットジムキョク\nProduct: ガタケットサークルカタログ"]}, {"names": ["同人誌生活文化総合研究所", "三崎尚人"], "misc": ["Genre: 評論・情報\nName (kana): ドウジンシセイカツブン\nemail: nmisaki@st.rim.or.jp\n同人誌を中心とした評論・情報サークルです。", "http://www.st.rim.or.jp/~nmisaki"]}, {"names": ["コメットぱーてぃ案内所", "山崎円花"], "misc": ["Genre: 評論・情報\nName (kana): コメットパーティアンナイシ\nProduct: コメットぱーてぃ本"]}, {"names": ["ショタケット準備会"], "misc": ["Genre: 評論・情報\nName (kana): ショタケットジュンビカイ"]}, {"names": ["夢幻通信社", "木弓るん"], "misc": ["Genre: 評論・情報\nName (kana): ムゲンツウシンシャ\nProduct: ごちゃまぜコミケのぶたいうら\n北海道札幌市の同人誌即売会「ごちゃまぜコミケ」を主催。札幌地区のイベント情報等も配布いたします。"]}, {"names": ["メカニコンS．LEIサービス"], "misc": ["Genre: 評論・情報\nName (kana): メカニコンエスエルイーアイサ\nProduct: LEI－0308"]}, {"names": ["Project Arbalest", "河合雅弘"], "misc": ["Genre: 評論・情報\nName (kana): プロジェクトアルバレス\nProduct: 「A6」イベントガイドブック\nemail: info@arbalest.jp\n長崎県佐世保市の同人誌即売会です。", "http://www.arbalest.jp/"]}, {"names": ["東京グリーン社", "如月みどり"], "m