]}, {"names": ["リョウアライとキャプテンミライのスペース"], "misc": ["Block: [ G ]\nビートPのリョウアライとボカロPのキャプテンミライの共同スペースです。今回も各々のCD作品を頒布します！新譜も予定しております！旧譜もまとめて頒布します！合い言葉はブロードウェイヴ！！！！！！！！！！！！", "http://www.riowarai.com/blog/?p=12007", "http://www.riowarai.com/blog/"]}, {"names": ["kapparecords"], "misc": ["Block: [ G ]\nオリジナルハードロック作品の他に東方プロジェクトMELTY BLOODアリスソフト作品ロマサガ３等の様式美ハードロックアレンジＣＤを頒布", "http://kapparecords.verse.jp/", "http://kapparecords.verse.jp/News/kapparecords_news_M3-2014autumn.html", "http://kapparecords.verse.jp/YukihisaKanatani/JPRS-012.html", "https://twitter.com/kappareOkada"]}, {"names": ["circumstance"], "misc": ["Block: [ G ]\nエレクトロニカ、アンビエント、テクノ 等、電子音楽を中心とした音源を頒布いたします。", "http://www.circumstance.info/"]}, {"names": ["Creche"], "misc": ["Block: [ G ]\n宇宙からやってきたテクノなアイドル、ペコちゃんの新譜を頒布予定！　Spectaclesも新譜が出ます。", "http://crh.jp/2014/"]}, {"names": ["ICON"], "misc": ["Block: [ G ]\n音楽や映像、ゲーム等を制作するマルチメディア系サークルです。", "http://iconcreator.web.fc2.com/html2/Top.html", "http://twitter.com/ICON_sh", "http://stargazercplus.web.fc2.com/", "http://twitter.com/stargazer_cplus"]}, {"names": ["C-CLAYS"], "misc": ["Block: [ G ]\n東方アレンジ＆艦これアレンジCDを中心に活動してます。", "http://www.c-clays.com/"]}, {"names": ["STRLabel + THB"], "misc": ["Block: [ G ]\nTechno・House・Electroを中心とした、モダン・クラブミュージック・レーベルです。", "http://str3.org"]}, {"names": ["らいぶり〜すとうぃんど"], "misc": ["Block: [ G ]\n同人音楽サークルのらいぶり〜すとうぃんどです。主にアコースティックなハウスや、吹奏楽などの曲を作っています。", "http://finelw.web.fc2.com/", "https://twitter.com/fine_sss", "https://soundcloud.com/fine_lw", "http://www.nicovideo.jp/mylist/20247360", "https://www.youtube.com/user/finelw"]}, {"names": ["しなもんしゅがー☆"], "misc": ["Block: [ G ]\nソフト電波系シンガーソングライター！一度聴いたら耳から離れないような電波ソング洗脳ソングですｗ今回は６月発売のボカロCDも持って行きます♪", "http://shinamonsugar.web.fc2.com/", "https://twitter.com/ShinamonShinako", "http://www.nicovideo.jp/watch/sm24680174", "http://www.nicovideo.jp/watch/sm24683185"]}, {"names": ["きみりんこ。"], "misc": ["Block: [ G ]\nオリジナルの幕末、新撰組のイメージソングを作っているサークルです。ボイスドラマＣＤも頒布しています。無料配布物もあります。", "http://kimirinko.x.fc2.com/"]}, {"names": ["Alice’Syndrome"], "misc": ["Block: [ G ]\nアニソン系ビッグバンドの生録CDを頒布いたします。", "http://twitter.com/Alices_Syndrome"]}, {"names": ["GlariZ"], "misc": ["Block: [ G ]\n痛ドゥーム同人音楽サークル。 アニソン等をドゥーム/ドローン/パワーアンビエントアレンジで音源制作しているサークルです。", "http://glariz.tumblr.com/", "http://twitter.com/@GlariZ1/"]}, {"names": ["Asuka"], "misc": ["Block: [ G ]\n――『Asuka』、始動。詞・作編曲・Vo他を務める《Riko》が、総べてA面と言えるインパクトのある曲作りを目指す。", "http://asukaofficial.blogspot.jp/", "https://twitter.com/Asuka_Tweet"]}, {"names": ["CUCURUSS"], "misc": ["Block: [ G ]\nスピーチシンセを使った音響プロジェクト。たまこまを音楽にしました。", "https://soundcloud.com/cucuruss", "https://twitter.com/ARALIA_E"]}, {"names": ["MusicLoad"], "misc": ["Block: [ G ]\nアニメ・ゲームの曲をリコーダーで演奏・多重録音しています。", "http://9-stars.net/hirokazu/musicload.htm", "http://www.nicovideo.jp/user/997218", "https://www.youtube.com/user/Hirokazu1829", "https://twitter.com/hirokazu_fue"]}, {"names": ["UnRapport"], "misc": ["Block: [ G ]\n人気PCゲームメーカー様やアイドルに楽曲提供を行っているアキバ系音楽制作集団です。", "http://unrapport.jimdo.com"]}, {"names": ["armonia"], "misc": ["Block: [ G ]\n好き勝手作る音楽サークルarmoniaです！今回は２枚の新譜を予定しております！さわやかポップから民族風、ハードロックまで多数お届けしてきたので今回も好き勝手作ります！", "http://armomania.web.fc2.com/"]}, {"names": ["ザ☆シュビドゥヴァーズ"], "misc": ["Block: [ G ]\n男声合唱×アニソン!", "http://theshubidovers.web.fc2.com"]}, {"names": ["METROFORTE Records"], "misc": ["Block: [ H ]\n畑 亜貴が 制作・プロデュースしたオリジナルコンテンツを発信していくレーベルです", "http://metroforte.com/", "https://twitter.com/metro_forte", "http://com.nicovideo.jp/community/co1977272"]}, {"names": ["イチコロ。"], "misc": ["Block: [ H ]\nアニソン・マッシュアップ・コーラスユニット", "http://ameblo.jp/ichicoro156/"]}, {"names": ["Peace☆"], "misc": ["Block: [ H ]\n主にオリジナル漫画の、イメージソングを作っています。", "http://www.geocities.jp/xxpeacestarxx/"]}, {"names": ["中目黒二丁目病院＆亡命(仮)"], "misc": ["Block: [ H ]\nアニメソング・ゲーム音楽・VOCALOID・♀Vo・♂Vo・オリジナル等、各種ございます。", "http://www.chu2byo.net/"]}, {"names": ["ScarlettGarage"], "misc": ["Block: [ H ]\n東武東上線は霞ヶ関〜鶴ヶ島間でクレーン車が架線に接触した事故の影響により、池袋〜小川町間で運転を見合わせています。", "http://scarlettgarage.wordpres